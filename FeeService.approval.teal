#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 0 1 8
    bytecblock "total_fees" "calls" "fee" 0x151f7c75 "last_result"
    txn ApplicationID
    bnz main_after_if_else@2
    // smart_contracts/fee_service/contract.py:8
    // self.total_fees = UInt64(0)
    bytec_0 // "total_fees"
    intc_0 // 0
    app_global_put
    // smart_contracts/fee_service/contract.py:9
    // self.calls = UInt64(0)
    bytec_1 // "calls"
    intc_0 // 0
    app_global_put
    // smart_contracts/fee_service/contract.py:10
    // self.last_result = UInt64(0)
    bytec 4 // "last_result"
    intc_0 // 0
    app_global_put
    // smart_contracts/fee_service/contract.py:11
    // self.fee = UInt64(100_000)  # 0.1 ALGO, in microAlgos
    bytec_2 // "fee"
    pushint 100000
    app_global_put

main_after_if_else@2:
    // smart_contracts/fee_service/contract.py:4
    // class FeeService(ARC4Contract):
    txn NumAppArgs
    bz main___algopy_default_create@14
    txn OnCompletion
    !
    assert
    txn ApplicationID
    assert
    pushbytess 0xe5cb6701 0x2faeaf9c 0xb70f3aa4 0x91848834 0xfc4b88b7 // method "service(pay,uint64)uint64", method "get_total_fees()uint64", method "get_calls()uint64", method "get_fee()uint64", method "set_fee(uint64)void"
    txna ApplicationArgs 0
    match service get_total_fees get_calls get_fee set_fee
    err

main___algopy_default_create@14:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


// smart_contracts.fee_service.contract.FeeService.service[routing]() -> void:
service:
    // smart_contracts/fee_service/contract.py:13
    // @abimethod()
    txn GroupIndex
    intc_1 // 1
    -
    dup
    gtxns TypeEnum
    intc_1 // pay
    ==
    assert // transaction type is pay
    txna ApplicationArgs 1
    dup
    len
    intc_2 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    // smart_contracts/fee_service/contract.py:16
    // assert payment.receiver == Global.creator_address, "fee must be paid to the creator"
    dig 1
    gtxns Receiver
    global CreatorAddress
    ==
    assert // fee must be paid to the creator
    // smart_contracts/fee_service/contract.py:17
    // assert payment.amount >= self.fee, "payment is less than the required fee"
    dig 1
    gtxns Amount
    intc_0 // 0
    bytec_2 // "fee"
    app_global_get_ex
    assert // check self.fee exists
    dig 1
    <=
    assert // payment is less than the required fee
    // smart_contracts/fee_service/contract.py:18
    // assert payment.sender == Txn.sender, "payment sender must be the caller"
    dig 2
    gtxns Sender
    txn Sender
    ==
    assert // payment sender must be the caller
    // smart_contracts/fee_service/contract.py:19
    // assert payment.rekey_to == Global.zero_address, "payment must not rekey"
    dig 2
    gtxns RekeyTo
    global ZeroAddress
    ==
    assert // payment must not rekey
    // smart_contracts/fee_service/contract.py:20
    // assert payment.close_remainder_to == Global.zero_address, "payment must not close remainder"
    uncover 2
    gtxns CloseRemainderTo
    global ZeroAddress
    ==
    assert // payment must not close remainder
    // smart_contracts/fee_service/contract.py:21
    // assert value <= UInt64(4_294_967_295), "value too large to square safely"
    dig 1
    pushint 4294967295
    <=
    assert // value too large to square safely
    // smart_contracts/fee_service/contract.py:23
    // result = value * value
    dig 1
    uncover 2
    *
    // smart_contracts/fee_service/contract.py:24
    // self.last_result = result
    bytec 4 // "last_result"
    dig 1
    app_global_put
    // smart_contracts/fee_service/contract.py:25
    // self.calls += 1
    intc_0 // 0
    bytec_1 // "calls"
    app_global_get_ex
    assert // check self.calls exists
    intc_1 // 1
    +
    bytec_1 // "calls"
    swap
    app_global_put
    // smart_contracts/fee_service/contract.py:26
    // self.total_fees += payment.amount
    intc_0 // 0
    bytec_0 // "total_fees"
    app_global_get_ex
    assert // check self.total_fees exists
    uncover 2
    +
    bytec_0 // "total_fees"
    swap
    app_global_put
    // smart_contracts/fee_service/contract.py:13
    // @abimethod()
    itob
    bytec_3 // 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return


